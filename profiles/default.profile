# Bindings shared by every game.
# Profiles that `extends = default` inherit these and list only what differs.
#
# Any key this profile does not name sends nothing at all, so a stray press
# cannot type into the game. Say `off` to drop an inherited binding.

[profile]
name = Common defaults

[keys]
k01 = esc          # menu / cancel
k09 = a
k10 = m            # map
pad = w s a d      # thumb pad: up down left right

[profile]
name = Phasmophobia
extends = default

[keys]
k03 = space        # in the live config, absent from the old committed .map
k05 = space        # likewise
k06 = esc
k07 = 1
k08 = 2
k09 = 3            # replaces the default `a`
k10 = j            # journal
k11 = leftshift
k12 = e
k13 = f
k14 = g
k15 = b
k16 = c
thumb = r
bar = t
